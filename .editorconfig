# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{java,kt,kts}]
indent_size = 4
continuation_indent_size = 8

[*.{xml,gradle}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false